{
  "schemaVersion": 1,
  "id": "protectmykeybinds",
  "version": "${version}",
  "name": "ProtectMyKeybinds",
  "description": "Prevents non-vanilla keybinds from being parsed in text components.",
  "authors": ["fridge"],
  "contact": {
    "homepage": "https://modrinth.com/mod/protectmykeybinds",
    "sources": "https://github.com/supafridge/ProtectMyKeybinds",
    "issues": "https://github.com/supafridge/ProtectMyKeybinds/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "gg.fridge.ProtectMyKeybinds.ModEntry"
    ]
  },
  "icon": "assets/protectmykeybinds/icon.png",
  "mixins": [
    "protectmykeybinds.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ["26.1.x", "26.2.x", "26.3.x"],
    "java": ">=25"
  }
}
